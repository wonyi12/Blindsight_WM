        abse = sub[sub.Stim == 'absent']   # S1
        pres = sub[sub.Stim == 'present']  # S2

        # ✅ HR/FAR 확인용
        Nsig = (sub.Stim == 'present').sum()
        Nnoi = (sub.Stim == 'absent').sum()
        
