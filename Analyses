        nR_S1 = [((abse.ConfLevel == r) & (abse.RespInt == 'no')).sum() for r in r_hi2lo] + \
        [((abse.ConfLevel == r) & (abse.RespInt == 'yes')).sum()  for r in r_lo2hi]

        nR_S2 = [((pres.ConfLevel == r) & (pres.RespInt == 'no')).sum() for r in r_hi2lo] + \
